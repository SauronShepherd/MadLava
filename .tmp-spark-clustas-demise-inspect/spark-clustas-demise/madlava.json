{
  "features": {
    "methodProfiling": {
      "enabled": true
    },
    "sparkSerialization": {
      "enabled": true,
      "profile": "ALL"
    }
  },
  "filters": {
    "methods": {
      "includes": [
        "com.esotericsoftware.kryo.Kryo.writeClassAndObject",
        "com.esotericsoftware.kryo.Kryo.reset",
        "org.apache.spark.util.ClosureCleaner$.clean"
      ],
      "excludes": []
    }
  }
}
